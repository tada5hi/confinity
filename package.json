{
    "name": "confinity",
    "version": "2.0.0",
    "type": "module",
    "description": "This is a library to load configurations in the context of a multi package application",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/confinity.git"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "husky"
    },
    "keywords": [],
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/tada5hi/confinity/issues"
    },
    "homepage": "https://github.com/tada5hi/confinity#readme",
    "dependencies": {
        "locter": "^4.1.0",
        "pathtrace": "^2.2.2",
        "smob": "^1.6.2"
    },
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.1",
        "@tada5hi/eslint-config": "^2.3.1",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^24.0.0",
        "@vitest/coverage-v8": "^4.1.9",
        "eslint": "^10.5.0",
        "husky": "^9.1.7",
        "tsdown": "^0.22.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vitest": "^4.1.9"
    }
}
